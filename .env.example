BIFROST_VERSION=v0.1.0-installtest.25
BIFROST_POSTGRES_RUNTIME=alpine17-v1
BIFROST_CONTROL_PLANE_IMAGE=bifrost/control-plane:v0.1.0-installtest.25
BIFROST_WEB_IMAGE=bifrost/web:v0.1.0-installtest.25
BIFROST_PUBLIC_URL=https://panel.example.net
BIFROST_LICENSE_URL=
BIFROST_LICENSE_TEST_INTAKE=false
BIFROST_PRIVACY_CONTROLLER_NAME=
BIFROST_PRIVACY_CONTACT=
BIFROST_PRIVACY_JURISDICTIONS=
BIFROST_PRIVACY_LAWFUL_BASES=
BIFROST_PRIVACY_PROCESSORS=
BIFROST_PRIVACY_DATA_REGION=
BIFROST_PRIVACY_REVIEW_APPROVED_AT=
BIFROST_PRIVACY_REVIEW_REFERENCE=
BIFROST_TRUSTED_PROXIES=127.0.0.1,::1,10.240.0.10
BIFROST_PRIVATE_SUBNET=10.240.0.0/24
BIFROST_WEB_NETWORK_IP=10.240.0.10
BIFROST_HTTP_BIND=127.0.0.1
BIFROST_HTTP_PORT=8080
BIFROST_POSTGRES_CPU_LIMIT=2.0
BIFROST_POSTGRES_MEMORY_LIMIT=2G
BIFROST_MIGRATE_CPU_LIMIT=2.0
BIFROST_MIGRATE_MEMORY_LIMIT=1G
BIFROST_API_CPU_LIMIT=2.0
BIFROST_API_MEMORY_LIMIT=1G
BIFROST_WEB_CPU_LIMIT=0.50
BIFROST_WEB_MEMORY_LIMIT=256M


# Node identity is persistent in PostgreSQL; changing this value does not transfer ownership.
BIFROST_NODE_ROLE=controller
BIFROST_NODE_HOSTNAME=
# Opt-in private IPv4 discovery ranges reachable from this Controller; empty disables scans.
BIFROST_DISCOVERY_CIDRS=
